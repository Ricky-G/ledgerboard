{
  "name": "ledgerboard",
  "displayName": "LedgerBoard",
  "description": "Local-first Markdown Kanban with conflict-safe autosave, actionable validation, safe formatting repair, and append-only analytics.",
  "version": "0.8.0",
  "publisher": "ricky-g",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ricky-G/ledgerboard.git"
  },
  "homepage": "https://github.com/Ricky-G/ledgerboard#readme",
  "bugs": {
    "url": "https://github.com/Ricky-G/ledgerboard/issues"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "kanban",
    "markdown",
    "tasks",
    "project management",
    "local-first",
    "analytics",
    "git",
    "git-backed",
    "offline"
  ],
  "galleryBanner": {
    "color": "#17202a",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ledgerBoard.openBoard",
        "title": "Open Board",
        "category": "LedgerBoard",
        "icon": "$(project)"
      },
      {
        "command": "ledgerBoard.initializeBoard",
        "title": "Initialize Board in Folder",
        "category": "LedgerBoard",
        "icon": "$(new-folder)"
      },
      {
        "command": "ledgerBoard.addOutcome",
        "title": "Add Ticket",
        "category": "LedgerBoard",
        "icon": "$(add)"
      },
      {
        "command": "ledgerBoard.validateBoard",
        "title": "Validate Board Bundle",
        "category": "LedgerBoard",
        "icon": "$(pass)"
      },
      {
        "command": "ledgerBoard.normalizeBoard",
        "title": "Normalize BOARD.md Formatting",
        "category": "LedgerBoard",
        "icon": "$(wand)"
      },
      {
        "command": "ledgerBoard.openStandard",
        "title": "Open Board Standard",
        "category": "LedgerBoard",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ledgerBoard.initializeBoard",
          "when": "explorerResourceIsFolder && resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "editor/title": [
        {
          "command": "ledgerBoard.validateBoard",
          "when": "resourceFilename == BOARD.md",
          "group": "navigation@80"
        },
        {
          "command": "ledgerBoard.normalizeBoard",
          "when": "resourceFilename == BOARD.md",
          "group": "navigation@81"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build:webview": "node scripts/build-webview.js",
    "compile": "npm run build:webview && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm run build:webview && npm-run-all2 -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:webview": "node scripts/build-webview.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run build:webview && npm run privacy:scan && npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint",
    "privacy:scan": "node scripts/privacy-scan.js",
    "check:release-notes": "node scripts/check-release-notes.js",
    "audit:dependencies": "node scripts/audit-dependencies.js",
    "static": "npm-run-all2 -s privacy:scan check:release-notes check-types lint audit:dependencies",
    "test": "npm-run-all2 -s test:unit test:tooling",
    "test:unit": "node --test --test-reporter=spec test/unit/**/*.test.js",
    "test:tooling": "node --test --test-reporter=spec test/tooling/**/*.test.js",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:performance": "node --test --test-reporter=spec test/performance/**/*.test.js",
    "pretest:packaging": "npm run vsix",
    "test:packaging": "node --test --test-reporter=spec test/packaging/**/*.test.js",
    "pretest:integration": "npm run compile-tests && npm run compile",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "pretest:webview": "playwright install --with-deps chromium",
    "test:webview": "playwright test",
    "test:all": "npm-run-all2 -s test:coverage test:performance test:webview test:integration test:packaging",
    "preflight": "npm-run-all2 -s static test:all",
    "validate:board": "node scripts/validate-board.js",
    "vsix": "vsce package --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "typescript-eslint": "8.67.0",
    "eslint": "^10.8.1",
    "esbuild": "^0.28.2",
    "npm-run-all2": "^9.0.3",
    "typescript": "^7.0.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
